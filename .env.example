# Copia este archivo como .env (o genera uno con: python scripts/crear_credenciales.py)
# En Vercel, estas mismas variables van en Settings > Environment Variables.

# desarrollo | produccion   (en Vercel se asume produccion)
ENTORNO=desarrollo

# Vacío en local = SQLite en datos_locales.db
# En producción: la cadena de conexión de Neon (postgresql://...)
DATABASE_URL=

# Firma de la cookie de sesión: al menos 32 caracteres aleatorios
SECRET_KEY=

# Hash Argon2 de tu contraseña (lo genera scripts/crear_credenciales.py; nunca la contraseña en texto)
APP_PASSWORD_HASH=

# Secreto de Google Authenticator (base32). Obligatorio en producción.
TOTP_SECRET=

# --- Opcionales (fases 2 y 4) ---
# Lectura de fotos de recibos y redacción del asesor con Claude
ANTHROPIC_API_KEY=
# claude-opus-5-5 (por defecto) o claude-haiku-5-5 (mucho más barato)
MODELO_IA=
# Recordatorios por Telegram (bot creado con @BotFather) y tu número de chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Protege /cron/diario (Vercel lo envía solo en el encabezado Authorization)
CRON_SECRET=
